name "Rust"
extensions ".rs"

words "keyword" as async await const crate dyn enum extern fn impl let mod move mut pub ref static struct super trait type union unsafe use where
words "keyword.control" break continue else for if in loop match return while yield
words "literal" true false
words "variable.special" self Self
words "storage.type.builtin" bool char f32 f64 i8 i16 i32 i64 i128 isize str u8 u16 u32 u64 u128 usize

context "main" {
    rule #"//[/!].*"# scope="comment.doc"
    rule #"//.*"# scope="comment"
    rule #"/\*"# scope="comment" push="block_comment"
    rule "b?r##\"" scope="string" push="raw_hash2"
    rule "b?r#\"" scope="string" push="raw_hash1"
    rule "b?r\"" scope="string" push="raw"
    rule "b?\"" scope="string" push="double"
    rule #"b?'(\\.[^']*|[^'\\])'"# scope="string"
    // a lifetime, or a loop label
    rule #"'[A-Za-z_]\w*"# scope="label"
    rule #"#!?\[[^\]]*\]?"# scope="attribute"
    rule #"[A-Za-z_]\w*"# words=#true
    rule #"[A-Za-z_]\w*!(?=\s*[\(\[\{])"# scope="function.macro"
    rule #"[A-Za-z_]\w*(?=\s*(::\s*<[^>]*>\s*)?\()"# scope="function"
    rule #"(?=[A-Z])[A-Za-z_]\w*"# scope="storage.type"
    rule #"[A-Za-z_]\w*"# scope="variable"
    rule #"0[xX][\h_]+\w*|0[bB][01_]+\w*|0[oO][0-7_]+\w*|\d[\d_]*(\.\d[\d_]*)?([eE][+\-]?\d+)?\w*"# scope="number"
}

// Rust's block comments nest
context "block_comment" scope="comment" {
    rule #"/\*"# push="block_comment"
    rule #"\*/"# pop=#true
}

context "double" scope="string" {
    rule #"\\."# scope="string.escape"
    rule "\"" pop=#true
}

context "raw" scope="string" {
    rule "\"" pop=#true
}

context "raw_hash1" scope="string" {
    rule "\"#" pop=#true
}

context "raw_hash2" scope="string" {
    rule "\"##" pop=#true
}
