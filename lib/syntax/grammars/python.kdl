name "Python"
extensions ".py" ".pyi" ".pyw"

words "keyword" as assert async class def del from global import lambda nonlocal
words "keyword.control" await break continue elif else except finally for if pass raise return try while with yield
words "keyword.operator" and in is not or
words "literal" False None True NotImplemented Ellipsis
words "variable.special" self cls
words "builtin" __import__ abs aiter all anext any ascii bin bool breakpoint bytearray bytes callable chr classmethod compile complex delattr dict dir divmod enumerate eval exec filter float format frozenset getattr globals hasattr hash help hex id input int isinstance issubclass iter len list locals map max memoryview min next object oct open ord pow print property range repr reversed round set setattr slice sorted staticmethod str sum super tuple type vars zip

context "main" {
    rule #"#.*"# scope="comment"
    rule #"[rRbBuUfF]{0,2}""""# scope="string" push="triple_double"
    rule #"[rRbBuUfF]{0,2}'''"# scope="string" push="triple_single"
    rule #"[rRbBuUfF]{0,2}""# scope="string" push="double"
    rule #"[rRbBuUfF]{0,2}'"# scope="string" push="single"
    rule #"^\s*@[\w.]+"# scope="attribute"
    rule #"[A-Za-z_]\w*"# words=#true
    rule #"[A-Za-z_]\w*(?=\()"# scope="function"
    rule #"(?=[A-Z])[A-Za-z_]\w*"# scope="storage.type"
    rule #"[A-Za-z_]\w*"# scope="variable"
    rule #"0[xX][\h_]+|0[bB][01_]+|0[oO][0-7_]+|\d[\d_]*(\.[\d_]*)?([eE][+\-]?\d+)?[jJ]?|\.\d[\d_]*([eE][+\-]?\d+)?[jJ]?"# scope="number"
}

// a string without triple quotes ends with its line
context "double" scope="string" pop_at_eol=#true {
    rule #"\\."# scope="string.escape"
    rule "\"" pop=#true
}

context "single" scope="string" pop_at_eol=#true {
    rule #"\\."# scope="string.escape"
    rule "'" pop=#true
}

context "triple_double" scope="string" {
    rule #"\\."# scope="string.escape"
    rule "\"\"\"" pop=#true
}

context "triple_single" scope="string" {
    rule #"\\."# scope="string.escape"
    rule "'''" pop=#true
}
