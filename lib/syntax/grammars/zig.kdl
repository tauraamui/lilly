name "Zig"
extensions ".zig" ".zon"

words "keyword" addrspace align allowzero anyframe anytype asm async await callconv comptime const enum error export extern fn inline linksection noalias noinline nosuspend opaque packed pub struct test threadlocal union usingnamespace var volatile
words "keyword.control" break catch continue defer else errdefer for if orelse resume return suspend switch try unreachable while
words "keyword.operator" and or
words "literal" true false null undefined
words "storage.type.builtin" i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize c_char c_short c_ushort c_int c_uint c_long c_ulong c_longlong c_ulonglong c_longdouble f16 f32 f64 f80 f128 bool anyopaque void noreturn type anyerror comptime_int comptime_float
words "builtin" "@addrSpaceCast" "@addWithOverflow" "@alignCast" "@alignOf" "@as" "@atomicLoad" "@atomicRmw" "@atomicStore" "@bitCast" "@bitOffsetOf" "@bitSizeOf" "@bitReverse" "@branchHint" "@breakpoint" "@byteSwap" "@call" "@cDefine" "@cImport" "@cInclude" "@clz" "@cmpxchgStrong" "@cmpxchgWeak" "@compileError" "@compileLog" "@constCast" "@ctz" "@cUndef" "@cVaArg" "@cVaCopy" "@cVaEnd" "@cVaStart" "@divExact" "@divFloor" "@divTrunc" "@embedFile" "@enumFromInt" "@errorCast" "@errorFromInt" "@errorName" "@errorReturnTrace" "@export" "@extern" "@field" "@fieldParentPtr" "@floatCast" "@floatFromInt" "@frameAddress" "@hasDecl" "@hasField" "@import" "@inComptime" "@intCast" "@intFromBool" "@intFromEnum" "@intFromError" "@intFromFloat" "@intFromPtr" "@max" "@memcpy" "@memmove" "@memset" "@min" "@mod" "@mulAdd" "@mulWithOverflow" "@offsetOf" "@panic" "@popCount" "@prefetch" "@ptrCast" "@ptrFromInt" "@rem" "@returnAddress" "@select" "@setEvalBranchQuota" "@setFloatMode" "@setRuntimeSafety" "@shlExact" "@shlWithOverflow" "@shrExact" "@shuffle" "@sizeOf" "@splat" "@sqrt" "@sin" "@cos" "@tan" "@exp" "@exp2" "@log" "@log2" "@log10" "@abs" "@floor" "@ceil" "@trunc" "@round" "@subWithOverflow" "@tagName" "@This" "@trap" "@truncate" "@Type" "@typeInfo" "@typeName" "@TypeOf" "@unionInit" "@Vector" "@volatileCast" "@wasmMemorySize" "@wasmMemoryGrow" "@workGroupId" "@workGroupSize" "@workItemId"

context "main" {
    rule #"//[/!].*"# scope="comment.doc"
    rule #"//.*"# scope="comment"
    // a line of a multiline string literal
    rule #"\\\\.*"# scope="string"
    rule "\"" scope="string" push="double"
    rule #"'(\\.[^']*|[^'\\])'"# scope="string"
    rule #"@"(\\.|[^"\\])*""# scope="variable"
    rule #"@?[A-Za-z_]\w*"# words=#true
    rule #"@[A-Za-z_]\w*"# scope="builtin"
    rule #"[iu]\d+(?!\w)"# scope="storage.type.builtin"
    rule #"[A-Za-z_]\w*(?=\()"# scope="function"
    rule #"(?=[A-Z])[A-Za-z_]\w*"# scope="storage.type"
    rule #"[A-Za-z_]\w*"# scope="variable"
    rule #"0[xX][\h_]+(\.[\h_]*)?([pP][+\-]?\d+)?|0[bB][01_]+|0[oO][0-7_]+|\d[\d_]*(\.\d[\d_]*)?([eE][+\-]?\d+)?"# scope="number"
}

context "double" scope="string" pop_at_eol=#true {
    rule #"\\."# scope="string.escape"
    rule "\"" pop=#true
}
